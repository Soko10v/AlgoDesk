# --- Supabase (production VPS) ---
# Project Settings → Database → Connection string (URI), then use asyncpg:
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Aliyun / some CN VPS hosts: TLS to Supabase may fail without this:
# DATABASE_SSL_INSECURE=true
# After schema is applied in Supabase (see supabase/README.md), disable auto-migrate on boot:
RUN_DB_MIGRATIONS=false

# Project Settings → API → URL and anon public key (same values for backend + frontend build)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Local dev without Supabase (docker compose --profile local-db up) ---
# DATABASE_URL=postgresql+asyncpg://algodesk:algodesk@postgres:5432/algodesk
# RUN_DB_MIGRATIONS=true

REDIS_URL=redis://redis:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
CRYPTOBOT_TOKEN=
CRYPTOBOT_WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000
DEV_AUTH=false
