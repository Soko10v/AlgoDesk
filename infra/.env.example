# --- Supabase (production VPS) ---
# Project Settings → Database → Connection string (URI), then use asyncpg:
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Aliyun / some CN VPS hosts: TLS to Supabase may fail without this:
# DATABASE_SSL_INSECURE=true
# After schema is applied in Supabase (see supabase/README.md), disable auto-migrate on boot:
RUN_DB_MIGRATIONS=false

# Project Settings → API → URL and anon public key (same values for backend + frontend build)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Local dev without Supabase (docker compose --profile local-db up) ---
# DATABASE_URL=postgresql+asyncpg://algodesk:algodesk@postgres:5432/algodesk
# RUN_DB_MIGRATIONS=true

REDIS_URL=redis://redis:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
CRYPTOBOT_TOKEN=
CRYPTOBOT_WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000
DEV_AUTH=false

# --- Risk & ops (optional) ---
# Hard cap on how many positions one user can hold open at once across strategies.
MAX_OPEN_POSITIONS_PER_USER=8
# Error monitoring (https://sentry.io). Leave empty to disable.
SENTRY_DSN=
# Telegram chat id that receives engine-health alerts (recovery failure, stalled bots).
ADMIN_TELEGRAM_ID=

# --- AI analysis (optional) ---
# DeepSeek API key enables the "AI analysis" button on the Backtest page.
DEEPSEEK_API_KEY=
# Optional overrides:
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Local OHLCV cache ---
# SQLite file with downloaded candle history (backtests/walk-forward read it
# instead of the exchange). docker-compose mounts a persistent volume at /data
# and sets this path; override only if you store the DB elsewhere.
# CANDLES_DB_PATH=/data/candles.db
# How many years of history to backfill on first start.
# CANDLES_YEARS_BACK=5
